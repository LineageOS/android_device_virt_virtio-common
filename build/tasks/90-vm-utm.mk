ifeq ($(USES_DEVICE_VIRT_VIRTIO_COMMON),true)
ifneq ($(TARGET_VM_UTM_TEMPLATE_DIR),)

UTM_VM_NOTES := Product name: $(TARGET_PRODUCT)

UTM_VM_NOTES += \nInitial version:
ifneq ($(LINEAGE_BUILD),)
UTM_VM_NAME := LineageOS
UTM_VM_NOTES += $(LINEAGE_VERSION)
else
UTM_VM_NAME := Android
UTM_VM_NOTES += $(PLATFORM_VERSION_LAST_STABLE) $(BUILD_ID) $(LOCAL_BUILD_DATE)
endif
UTM_VM_NAME += on $(TARGET_ARCH)

UTM_VM_NOTES += \nPartition scheme:
ifeq ($(AB_OTA_UPDATER),true)
UTM_VM_NOTES += Virtual A/B
else
UTM_VM_NOTES += non-A/B
endif

UTM_VM_NOTES += \nSuper partition size: $(BOARD_SUPER_PARTITION_SIZE)

UTM_VM_OUT_DIR := $(PRODUCT_OUT)/VirtualMachine/UTM/$(UTM_VM_NAME).utm
UTM_VM_OUT_DATA_DIR := $(UTM_VM_OUT_DIR)/Data
UTM_VM_OUT_DISK_IMAGE_VDA := $(UTM_VM_OUT_DATA_DIR)/vda.img
UTM_VM_OUT_DISK_IMAGE_VDB := $(UTM_VM_OUT_DATA_DIR)/vdb.qcow2

UTM_VM_DISK_IMAGE_VDA_SOURCE := $(INSTALLED_DISKIMAGE_VDA_TARGET)
UTM_VM_DISK_IMAGE_VDB_SOURCE := $(COMMON_PATH)/misc/empty-16G.qcow2

UTM_VM_TEMPLATE_CONFIG_PLIST := $(TARGET_VM_UTM_TEMPLATE_DIR)/config.plist
UTM_VM_TEMPLATE_EFI_VARS_FD := $(TARGET_VM_UTM_TEMPLATE_DIR)/efi_vars.fd

UTM_VM_DEPS := \
    $(UTM_VM_DISK_IMAGE_VDA_SOURCE) \
    $(UTM_VM_DISK_IMAGE_VDB_SOURCE) \
    $(UTM_VM_TEMPLATE_CONFIG_PLIST) \
    $(UTM_VM_TEMPLATE_EFI_VARS_FD)

INSTALLED_UTM_VM_CONFIG_PLIST_TARGET := $(UTM_VM_OUT_DIR)/config.plist
$(INSTALLED_UTM_VM_CONFIG_PLIST_TARGET): $(UTM_VM_DEPS)
	$(call pretty,"Target UTM VM: $(UTM_VM_OUT_DIR)")
	mkdir -p $(UTM_VM_OUT_DATA_DIR)
	mkdir -p $(UTM_VM_OUT_DIR)/../__MACOSX

	cp $(UTM_VM_TEMPLATE_EFI_VARS_FD) $(UTM_VM_OUT_DATA_DIR)/efi_vars.fd

	rm -f $(UTM_VM_OUT_DISK_IMAGE_VDA)
	ln $(UTM_VM_DISK_IMAGE_VDA_SOURCE) $(UTM_VM_OUT_DISK_IMAGE_VDA)

	cp $(UTM_VM_DISK_IMAGE_VDB_SOURCE) $(UTM_VM_OUT_DISK_IMAGE_VDB)

	cp $(UTM_VM_TEMPLATE_CONFIG_PLIST) $(INSTALLED_UTM_VM_CONFIG_PLIST_TARGET)
	sed -i "s|@UTM_VM_NAME@|$(UTM_VM_NAME)|g" $(INSTALLED_UTM_VM_CONFIG_PLIST_TARGET)
	sed -i "s|@UTM_VM_NOTES@|$(UTM_VM_NOTES)|g" $(INSTALLED_UTM_VM_CONFIG_PLIST_TARGET)

.PHONY: vm-utm
vm-utm: $(INSTALLED_UTM_VM_CONFIG_PLIST_TARGET)

endif # TARGET_VM_UTM_TEMPLATE_DIR
endif # USES_DEVICE_VIRT_VIRTIO_COMMON
